# The root .gitignore un-ignores resources_servers/*/data/example*.jsonl, which also matches Gym's
# side outputs. Committed: example.jsonl, example_rollouts.jsonl, example_metrics.json and
# example.jsonl.meta.json (make_tasks.py's command/config record for the rows: AGENTS.md open-data rule).
!example.jsonl.meta.json
*_prepare.jsonl
example_rollouts_materialized_inputs.jsonl
example_rollouts_failures.jsonl
example_rollouts_reward_profiling.jsonl
example_rollouts_aggregate_metrics.json
example_rollouts_agent_metrics.json
example_rollouts_repeat_level_metrics.json
