  {
    "id": "message-support-meter",
    "request": "Send a message to support saying my meter is broken.",
    "start_path": "/",
    "initial_state_overrides": {},
    "check": {"all": [
      {"path": "messages.sent.0.to", "op": "eq", "value": "support"},
