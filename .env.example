# Copy to .env (gitignored) and fill in. Load with:  set -a; source .env; set +a
# Never commit real values, and never paste them into a coding agent.
export NVIDIA_API_KEY=      # build.nvidia.com: hosted Nemotron 3.5 Lightning
export HF_TOKEN=            # read-only for everyone; a write token only on Patrick's laptop (publishing)
# On the Brev box, HF_HOME etc. come from /home/ubuntu/serving.env (docs/gpu-box.md §1).
