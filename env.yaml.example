# NeMo Gym local config. Copy to env.yaml (gitignored) in the repo root.
# The policy model is the grounder served by vLLM on the Brev box (docs/gpu-box.md §3).
policy_base_url: http://127.0.0.1:8001/v1   # via tunnel from a laptop, or directly on the box
policy_api_key: EMPTY
policy_model_name: base                    # vLLM served name: `base` for baselines, `grounder` (LoRA) after SFT

# For hosted Lightning instead:
# policy_base_url: https://integrate.api.nvidia.com/v1
# policy_api_key: <your NVIDIA_API_KEY>
# policy_model_name: nvidia/nemotron-3.5-lightning-30b-a3b

# Optional:
# skip_venv_if_present: true
# server_spinup_timeout_seconds: 1800
