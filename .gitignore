# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.venv*
**/.venv
**/.venv.setup.lock
.python-version
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Secrets and local config
.env
.env.*
!.env.example
env.yaml

# Data, models, outputs (publish to Hugging Face, not git); root-level only so
# Gym env example data (resources_servers/*/data/) can still be committed
/data/
/datasets/
/checkpoints/
/outputs/
/results/
/runs/
/wandb/
/cache/
*.safetensors
*.bin
*.pt
*.ckpt
*.gguf
*.zip
*.7z
*.tar
*.tar.gz
*.parquet
*.arrow

# Playwright / Node
node_modules/
test-results/
playwright-report/
playwright/.cache/

# Trainer / tool outputs written relative to the working directory
**/wandb/
**/trainer_output/
**/outputs/
**/.hydra/
*.log
nohup.out

# Gym env data: only small examples are committed
resources_servers/*/data/*
!resources_servers/*/data/example*.jsonl
!resources_servers/*/data/example_metrics.json
!resources_servers/*/data/.gitignore

# Agent / tool local files
.playwright-mcp/
CLAUDE.local.md
.claude/worktrees/
.claude/settings.local.json

# OS / editors
.DS_Store
.idea/
.vscode/
*.swp
.claude/orchestrator-state.md
